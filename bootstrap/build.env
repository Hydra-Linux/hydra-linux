#!/bin/bash
# build.env - Hydra Linux build environment
# Source this from all stage scripts

export TARGET=x86_64-linux-gnu
export JOBS=$(nproc)
export MAKEFLAGS="-j$JOBS"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
export SOURCES_DIR="${PROJECT_DIR}/build/sources"
export BUILD_DIR="${PROJECT_DIR}/build/make"
export SYSROOT="${PROJECT_DIR}/build/sysroot"
export CROSS_TOOLS_DIR="${PROJECT_DIR}/build/cross-tools"

export GREEN='\033[0;32m'
export RED='\033[0;31m'
export YELLOW='\033[1;33m'
export RESET='\033[0m'