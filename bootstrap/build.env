#!/bin/bash
# build.env - Hydra Linux build environment
# Source this from all stage scripts

export TARGET=x86_64-linux-gnu
export JOBS=$(nproc)
export MAKEFLAGS="-j$JOBS"

export BASEDIR=$(cd "$(dirname "$0")" && pwd)
export SOURCES_DIR="${BASEDIR}/sources"
export BUILD_DIR="${BASEDIR}/build"
export SYSROOT="${BASEDIR}/sysroot"
export CROSS_TOOLS_DIR="${BASEDIR}/cross-tools"

export GREEN='\033[0;32m'
export RED='\033[0;31m'
export YELLOW='\033[1;33m'
export RESET='\033[0m'